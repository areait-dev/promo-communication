# URL base del WordPress headless (senza slash finale)
WORDPRESS_URL=https://wp.promocommunication.it
# Endpoint GraphQL (se usi WPGraphQL) oppure usa la REST API: ${WORDPRESS_URL}/wp-json/wp/v2
WORDPRESS_GRAPHQL_URL=https://wp.promocommunication.it/graphql
# URL pubblico del frontend Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Invio email dei form (Resend, https://resend.com)
# Senza queste tre variabili in sviluppo l'email viene solo stampata nel terminale; in produzione l'invio fallisce.
# Chiave API (resend.com/api-keys)
RESEND_API_KEY=
# Mittente su un dominio verificato in Resend (Domains). Per provare senza dominio: "Promo Communication <onboarding@resend.dev>" (arriva solo all'email dell'account Resend)
MAIL_FROM="Promo Communication <sito@promocommunication.it>"
# Chi riceve le richieste (più indirizzi separati da virgola)
MAIL_TO=info@promocommunication.it

# WordPress headless: lettura delle bozze per l'anteprima (utente "headless" con password applicazione)
# Utente WordPress dedicato, ruolo Editor
WORDPRESS_USER=
# Password applicazione (Utenti > Profilo > Password applicazione). Solo su Vercel, mai in un file del progetto
WORDPRESS_APP_PASSWORD=
# Stringa lunga a caso: la stessa di PC_PREVIEW_SECRET in wp-config.php
PREVIEW_SECRET=
# Stringa lunga a caso: la stessa di PC_REVALIDATE_TOKEN in wp-config.php (aggiornamento immediato del sito quando si pubblica)
REVALIDATE_TOKEN=
