# URL base del WordPress headless (senza slash finale)
WORDPRESS_URL=https://wp.promocommunication.it
# Endpoint GraphQL (se usi WPGraphQL) oppure usa la REST API: ${WORDPRESS_URL}/wp-json/wp/v2
WORDPRESS_GRAPHQL_URL=https://wp.promocommunication.it/graphql
# URL pubblico del frontend Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3000
